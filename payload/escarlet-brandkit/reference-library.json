{
  "site": "escarlet",
  "version": "3.0.0",
  "selectionPolicy": {
    "mode": "deterministic",
    "assistantMayChoose": false,
    "assistantMaySubstitute": false,
    "priority": ["default"]
  },
  "styleBoards": {
    "style": { "filename": "style-board.png", "description": "Tablero visual maestro de la marca" },
    "character": { "filename": "character-board.png", "description": "Tablero de personajes (Silvia y Charly)" },
    "logo": { "filename": "logo-official-blue.png", "description": "Logo PNG para grounding del agente cuando lo pide" }
  },
  "logos": {
    "png": { "filename": "logo-official-blue.png", "usage": "agent_reference" },
    "svgWhite": { "filename": "logo-official-white.svg", "usage": "agent_reference" },
    "svgBlue": { "filename": "logo-official-blue.svg", "usage": "agent_reference" }
  },
  "routes": {
    "default": ["style-board.png"],
    "with_character": ["style-board.png", "character-board.png"],
    "character": ["character-board.png"],
    "logo": ["logo-official-blue.png"]
  },
  "references": [
    {
      "id": "esc-style-board",
      "role": "style-board",
      "filename": "style-board.png",
      "approved": true,
      "required": true,
      "alt": "Sistema visual Escarlet: paleta, tipografía, composición y biblioteca visual"
    },
    {
      "id": "esc-character-board",
      "role": "character-board",
      "filename": "character-board.png",
      "approved": true,
      "required": false,
      "usage": "character",
      "alt": "Tablero de personajes Escarlet"
    },
    {
      "id": "esc-character-silvia",
      "role": "character",
      "filename": "character-silvia.png",
      "approved": true,
      "required": false,
      "usage": "character",
      "characterId": "silvia",
      "alt": "Personaje Silvia"
    },
    {
      "id": "esc-character-charly",
      "role": "character",
      "filename": "character-charly.png",
      "approved": true,
      "required": false,
      "usage": "character",
      "characterId": "charly",
      "alt": "Personaje Charly"
    },
    {
      "id": "esc-logo-png",
      "role": "logo",
      "filename": "logo-official-blue.png",
      "approved": true,
      "required": false,
      "usage": "logo",
      "alt": "Logo Escarlet PNG (wordmark sobre azul)"
    }
  ]
}
