{
  "site": "escarlet",
  "version": "2.2.0",
  "designSystem": {
    "primaryColor": "#47A4E7",
    "typography": "Montserrat, Arial, sans-serif",
    "heroCtaGradient": {
      "enabled": true,
      "from": "#12B8D6",
      "to": "#E8B73A",
      "direction": "teal-to-gold",
      "usage": ["web heroes", "web CTAs"]
    }
  },
  "cover": {
    "aspectRatio": "3:2",
    "preferredSizes": ["1536x1024", "1024x1024"],
    "allowText": false,
    "defaultAbstraction": "media",
    "negativeSpace": "reservar al menos un 25% del encuadre sin detalle crítico",
    "treatment": ["grano sutil", "luz natural", "color contenido", "materia visible"]
  },
  "social": {
    "canvas": { "width": 1080, "height": 1350, "safeTop": 88, "safeRight": 88, "safeBottom": 88, "safeLeft": 88 },
    "textSource": "template",
    "backgroundSource": "ai",
    "renderOrder": ["background", "positionTreatment", "accent", "headline", "body", "logo"],
    "consistency": ["un template por carrusel", "un solo acento de marca por slide", "misma retícula", "máximo dos niveles de texto", "texto grande legible en móvil", "primera y última slide con colores puros y logo oficial", "slides centrales claras y generalistas", "una, dos o tres líneas por bloque; dividir si desborda"],
    "carouselRules": {
      "firstSlide": { "background": "brand-colors-pure", "overlay": "none", "textColor": "#FFFFFF", "logo": "official-white" },
      "middleSlides": { "background": "light-generalist", "avoidSaturatedColors": true, "textColor": "#1E1E1E", "logo": "none" },
      "lastSlide": { "background": "brand-colors-pure", "overlay": "none", "textColor": "#FFFFFF", "logo": "official-white" },
      "maxLinesPerBlock": 3,
      "minimumHeadlineFontSize": 86,
      "minimumBodyFontSize": 34,
      "overflow": "split-into-another-slide"
    }
  },
  "qualityGates": {
    "cover": ["hasNoEmbeddedText", "archetypeIsNotRepeated", "usesApprovedReferences", "hasDecisionMetadata"],
    "social": ["textRenderedByTemplate", "fontIsDeclared", "slideCountBetween4And7", "sameTemplateAcrossCarousel", "hasBackgroundMetadata"]
  }
}
