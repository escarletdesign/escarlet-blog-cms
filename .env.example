PORT=3040
# Required: use a long random token; the server fails closed when unset
ADMIN_TOKEN=
DEFAULT_SITE=escarlet
CMS_PUBLIC_URL=http://localhost:3040
# En Coolify usa https://blog-cms.escarlet.cc (si queda localhost, las fotos se rompen en el dashboard)
# Volumen persistente. En Coolify debe coincidir con Destination Path del storage (por defecto /app/data)
CMS_DATA_DIR=
WORKER_ENABLED=1
WORKER_POLL_MS=5000
WORKER_MAX_ATTEMPTS=5
METRICOOL_POLL_MS=300000
# Motion jobs use the local FFmpeg adapter by default. Set to false to force
# an external provider handoff, or set FFMPEG_PATH when the binary is custom.
MOTION_RENDERER_LOCAL=true
DEFAULT_MOTION_PROVIDER=local
# FFMPEG_PATH=/usr/local/bin/ffmpeg
PRODUCT_RENDERER_LOCAL=true
REBUILD_WEBHOOK_URL=
COOLIFY_API_TOKEN=

# Product restructure (F0+)
# PRODUCT_RESTRUCTURE_V1=1

# CMS AI REST gateway and provider integrations. Set to 0 to use only ChatGPT via MCP and manual editing.
CMS_AI_ENABLED=0

# Stripe Payment Links (F4). Webhook endpoint: POST /api/stripe/webhook
# Payment Link metadata: site=<handle>, kind=setup|membership|hosting, planId=standard
# STRIPE_WEBHOOK_SECRET=whsec_...
# Required for production v2/workspaces/jobs and Stripe idempotency
# DATABASE_URL=postgres://user:pass@host:5432/escarlet_blog

# Magic link email (F1). Without key, links are logged for ops paste.
# RESEND_API_KEY=
# RESEND_FROM=Escarlet CMS <onboarding@resend.dev>

# PWA AI gateway (keys stay on the CMS server; Gemini/Grok adapters are opt-in stubs)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Required only to persist API keys entered in Admin → IA y Billing. Use 32+ random bytes (64 hex chars recommended).
# AI_CONNECTOR_ENCRYPTION_KEY=
# Shared AES-256-GCM key for Metricool and other workspace connectors (32+ bytes)
# CMS_SECRET_KEY=
# Optional default Postiz API base. Leave empty for Postiz Cloud; for a
# self-hosted instance use the public backend URL, usually ending in /api.
# POSTIZ_API_BASE_URL=
# Optional temporary migration switch for an existing plaintext data/DB only; save every connector to re-encrypt it, then remove it.
# AI_CONNECTOR_ALLOW_LEGACY_PLAINTEXT=

# PWA Stripe Checkout / Customer Portal (price IDs are never sent to the browser)
# STRIPE_SECRET_KEY=sk_live_...
# PWA_STRIPE_PRICE_PLAN_STARTER=price_...
# PWA_STRIPE_PRICE_PLAN_STANDARD=price_...
# PWA_STRIPE_PRICE_PLAN_GROWTH=price_...
# PWA_STRIPE_PRICE_CREDITS_25K=price_...
# PWA_STRIPE_PRICE_CREDITS_100K=price_...
# PWA_STRIPE_PRICE_CREDITS_500K=price_...

# Local loopback auto-login as admin. Set to 0 to test the login screen.
# LOCAL_AUTO_LOGIN=0

# Human email/password (F5). Register via POST /api/auth/register (agency/admin).
# Login via POST /api/auth/login. Google OAuth deferred.
# Users stored in data/users.json

# MCP (Cursor mcp.json)
# CMS_URL=http://localhost:3040
# CMS_ADMIN_TOKEN=<same long random ADMIN_TOKEN>

# Optional Auth0 resource-server validation for MCP v3. Leave all variables
# unset to use the built-in PAT/OAuth connector. Partial configuration rejects
# JWT bearers instead of falling back to a weaker authentication path.
# AUTH0_ENABLED=1
# AUTH0_ISSUER=https://<tenant>.<region>.auth0.com/
# AUTH0_AUDIENCE=https://cms.escarlet.design/mcp/v3
# AUTH0_JWKS_URL=https://<tenant>.<region>.auth0.com/.well-known/jwks.json
# AUTH0_CLAIM_NAMESPACE=https://escarlet.design/
# AUTH0_USER_ID_CLAIM=https://escarlet.design/user_id
# AUTH0_WORKSPACE_ID_CLAIM=https://escarlet.design/workspace_id
# AUTH0_WORKSPACE_IDS_CLAIM=https://escarlet.design/workspace_ids
# AUTH0_SITE_IDS_CLAIM=https://escarlet.design/site_ids
# AUTH0_SITES_CLAIM=https://escarlet.design/sites
# AUTH0_ROLE_CLAIM=https://escarlet.design/role
# AUTH0_PERMISSIONS_CLAIM=permissions

# Auth0 login for the web UI. This is separate from MCP authentication and
# uses the Regular Web Application flow on the server.
# AUTH0_UI_ENABLED=1
# AUTH0_DOMAIN=dev-vj4y1m2thr545tlv.us.auth0.com
# AUTH0_CLIENT_ID=<auth0-client-id>
# AUTH0_CLIENT_SECRET=<auth0-client-secret>
# AUTH0_UI_CALLBACK_URL=https://cms.escarlet.design/api/auth0/callback
# AUTH0_UI_LOGOUT_URL=https://cms.escarlet.design/app
# AUTH0_UI_USER_ID_CLAIM=https://escarlet.design/user_id
