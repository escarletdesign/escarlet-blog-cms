PORT=3040
# Required: use a long random token; the server fails closed when unset
ADMIN_TOKEN=
DEFAULT_SITE=escarlet
CMS_PUBLIC_URL=http://localhost:3040
# En Coolify usa https://blog-cms.escarlet.cc (si queda localhost, las fotos se rompen en el dashboard)
# Volumen persistente. En Coolify debe coincidir con Destination Path del storage (por defecto /app/data)
CMS_DATA_DIR=
REBUILD_WEBHOOK_URL=
COOLIFY_API_TOKEN=

# Product restructure (F0+)
# PRODUCT_RESTRUCTURE_V1=1

# Stripe Payment Links (F4). Webhook endpoint: POST /api/stripe/webhook
# Payment Link metadata: site=<handle>, kind=setup|membership|hosting, planId=standard
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional Coolify Postgres for idempotent ledger (falls back to data/stripe-ledger.json)
# DATABASE_URL=postgres://user:pass@host:5432/cms

# Magic link email (F1). Without key, links are logged for ops paste.
# RESEND_API_KEY=
# RESEND_FROM=Escarlet CMS <onboarding@resend.dev>

# PWA AI gateway (keys stay on the CMS server; Gemini/Grok adapters are opt-in stubs)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Required only to persist API keys entered in Admin → IA y Billing. Use 32+ random bytes (64 hex chars recommended).
# AI_CONNECTOR_ENCRYPTION_KEY=
# Optional temporary migration switch for an existing plaintext data/DB only; save every connector to re-encrypt it, then remove it.
# AI_CONNECTOR_ALLOW_LEGACY_PLAINTEXT=

# PWA Stripe Checkout / Customer Portal (price IDs are never sent to the browser)
# STRIPE_SECRET_KEY=sk_live_...
# PWA_STRIPE_PRICE_PLAN_STARTER=price_...
# PWA_STRIPE_PRICE_PLAN_STANDARD=price_...
# PWA_STRIPE_PRICE_PLAN_GROWTH=price_...
# PWA_STRIPE_PRICE_CREDITS_25K=price_...
# PWA_STRIPE_PRICE_CREDITS_100K=price_...
# PWA_STRIPE_PRICE_CREDITS_500K=price_...

# Human email/password (F5). Register via POST /api/auth/register (agency/admin).
# Login via POST /api/auth/login. Google OAuth deferred.
# Users stored in data/users.json

# MCP (Cursor mcp.json)
# CMS_URL=http://localhost:3040
# CMS_ADMIN_TOKEN=<same long random ADMIN_TOKEN>
