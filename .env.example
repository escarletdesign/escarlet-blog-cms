PORT=3040
ADMIN_TOKEN=cambia-esto
DEFAULT_SITE=escarlet
CMS_PUBLIC_URL=http://localhost:3040
# En Coolify usa https://blog-cms.escarlet.cc (si queda localhost, las fotos se rompen en el dashboard)
# Volumen persistente. En Coolify debe coincidir con Destination Path del storage (por defecto /app/data)
CMS_DATA_DIR=
REBUILD_WEBHOOK_URL=
COOLIFY_API_TOKEN=

# Product restructure (F0+)
# PRODUCT_RESTRUCTURE_V1=1

# Stripe Payment Links (F4). Webhook endpoint: POST /api/stripe/webhook
# Payment Link metadata: site=<handle>, kind=setup|membership|hosting, planId=standard
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional Coolify Postgres for idempotent ledger (falls back to data/stripe-ledger.json)
# DATABASE_URL=postgres://user:pass@host:5432/cms

# Magic link email (F1). Without key, links are logged for ops paste.
# RESEND_API_KEY=

# MCP (Cursor mcp.json)
# CMS_URL=http://localhost:3040
# CMS_ADMIN_TOKEN=cambia-esto
