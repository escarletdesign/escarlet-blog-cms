{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://escarlet.design/schemas/instagram-slide.schema.json",
  "type": "object",
  "required": ["id", "headline", "body", "templateId", "imageUrl", "alt"],
  "properties": {
    "id": { "type": "string" },
    "headline": { "type": "string", "maxLength": 90 },
    "body": { "type": "string", "maxLength": 240 },
    "templateId": { "enum": ["editorial", "impact"] },
    "imageUrl": { "type": "string" },
    "alt": { "type": "string" },
    "backgroundStyle": { "type": "string" },
    "backgroundMediaId": { "type": "string" },
    "backgroundSource": { "enum": ["ai", "cms", ""] },
    "renderedBy": { "const": "content-system/instagram-renderer" }
  }
}
