{
  "handle": "escarlet",
  "name": "Escarlet",
  "domain": "https://escarlet.design",
  "adapter": "json-api",
  "requiresHumanApproval": true,
  "rebuildWebhookEnv": "REBUILD_WEBHOOK_URL",
  "seo": {
    "minWords": 400,
    "metaTitleMin": 20,
    "metaTitleMax": 70,
    "metaDescriptionMin": 70,
    "metaDescriptionMax": 180,
    "internalLinksMin": 1,
    "internalLinksMax": 8,
    "relatedSlugsCount": 0,
    "canonicalPattern": "{domain}/blog/{slug}"
  },
  "authors": ["Charly", "Silvia"],
  "copyRules": { "noColonsSemicolons": true }
}
