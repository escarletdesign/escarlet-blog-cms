{
  "version": "2.0.0",
  "system": "content-system",
  "global": {
    "avoidEmbeddedText": true,
    "referenceFidelity": "high",
    "altText": "Describe la escena de forma breve, concreta y fiel a la pieza.",
    "fixedIdentity": {
      "palette": ["#F4F1EA", "#1F4D3A", "#15352A", "#1B211D", "#C8674B"],
      "typography": "Inter, Arial, sans-serif",
      "coverHasText": false
    },
    "referenceSelection": {
      "approvedOnly": true,
      "mustConsultForAnyImage": true,
      "passToGenerator": true,
      "coverCountAutomatic": 2,
      "coverCountExploration": 3,
      "socialCount": 1
    },
    "archetypes": "content-system/brand/escarlet-image-archetypes.json",
    "templates": "content-system/brand/escarlet-social-templates.json"
  },
  "blogCover": {
    "allowText": false,
    "aspectRatio": "3:2",
    "recentPostsToInspect": 6,
    "maxConsecutiveArchetype": 1,
    "forceDifferentTopicSimilarity": 0.62,
    "metadataRequired": ["archetype", "composition", "references", "negativeRules", "decision"]
  },
  "instagramCarousel": {
    "slides": { "min": 4, "max": 7, "default": 4 },
    "dimensions": "1080x1350",
    "allowText": true,
    "textSource": "template",
    "textRenderer": "content-system/instagram-renderer.mjs",
    "textGuidance": "Monta únicamente el headline y body con el template declarado. Mantén el texto breve, legible en un móvil desde la primera lectura y con ortografía exacta; no inventes palabras ni logotipos. Si no cabe, acorta el copy o divide la idea entre slides. Nunca reduzcas la tipografía hasta hacerla ilegible.",
    "mobileReadability": {
      "required": true,
      "firstRead": true,
      "allowFontShrinkingToFit": false,
      "overflowAction": "shorten-or-split"
    },
    "backgroundGeneration": { "allowText": false, "role": "instagram-carousel-background" },
    "templates": ["editorial", "impact"],
    "firstSlide": {
      "background": "brand-color",
      "allowGradients": true
    },
    "middleSlides": {
      "background": "light-or-grayscale",
      "avoidSaturatedColors": true
    },
    "lastSlide": {
      "background": "brand-color",
      "allowGradients": true
    }
  }
}
